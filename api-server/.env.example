JWT_REFRESH_SECRET=
INTERNAL_WS_SHARED_SECRET=

# Give values in a format accepted by the ms package, e.g. "15m", "1h", "7d".
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
