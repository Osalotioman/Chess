HOST=0.0.0.0
PORT=8080

# Comma-separated origins. Use * to allow all origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# When true, sends Access-Control-Allow-Credentials: true.
CORS_ALLOW_CREDENTIALS=true

# Allow requests/upgrades that do not send an Origin header (CLI tools, server-to-server).
CORS_ALLOW_NO_ORIGIN=true
